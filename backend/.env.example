# ---------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------
PORT=5002
NODE_ENV=development
CLIENT_URL=https://tickethub-ivory.vercel.app

# ---------------------------------------------------------------------
# MySQL Database
# ---------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=tickethub

# ---------------------------------------------------------------------
# JWT Auth
# ---------------------------------------------------------------------
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------
# Seat hold / waitlist offer TTLs (in minutes)
# ---------------------------------------------------------------------
SEAT_HOLD_TTL_MINUTES=10
WAITLIST_OFFER_TTL_MINUTES=10

# How often the expiry scheduler sweeps for expired holds/offers (in seconds)
SCHEDULER_INTERVAL_SECONDS=30

# ---------------------------------------------------------------------
# Email (SMTP) - works with any provider (Gmail, SendGrid, Mailtrap, etc.)
# For Gmail: use an "App Password", not your normal password.
# ---------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM="TicketHub <no-reply@tickethub.com>"
